<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Página no encontrada (404) | Capilla San Francisco de Asís</title>
  <meta name="robots" content="noindex, follow">
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Cinzel, Great Vibes, Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Great+Vibes&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/css/main.css">
  <style>
    body {
      background-color: #FAF6F0;
      color: #1A1715;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .font-cinzel { font-family: 'Cinzel', serif; }
    .font-script { font-family: 'Great Vibes', cursive; }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-amber-200 selection:text-amber-950">

  <!-- Encabezado simple -->
  <header class="py-6 px-4 border-b border-stone-200/60 bg-white/70 backdrop-blur-md">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <a href="index.html" class="flex items-center gap-3 group">
        <!-- Icono de Cruz y San Francisco -->
        <svg class="w-10 h-10 text-[#794625] transition-transform group-hover:scale-105" viewBox="0 0 100 100" fill="currentColor">
          <circle cx="50" cy="22" r="10" />
          <path d="M20 38 Q50 30 80 38 L84 52 Q68 44 57 48 L62 90 Q50 93 38 90 L43 48 Q32 44 16 52 Z" />
          <path d="M47 34 L53 34 L53 47 L47 47 Z" fill="#FFFFFF" />
          <path d="M42 39 L58 39 L58 43 L42 43 Z" fill="#FFFFFF" />
        </svg>
        <div>
          <span class="block text-xs uppercase tracking-widest text-stone-500 font-cinzel">Capilla</span>
          <span class="font-cinzel font-bold text-lg text-[#794625] leading-tight">San Francisco de Asís</span>
        </div>
      </a>

      <a href="index.html" class="text-xs uppercase tracking-wider font-semibold text-[#794625] hover:text-amber-800 flex items-center gap-1.5 transition-colors">
        <span>← Volver al Portal</span>
      </a>
    </div>
  </header>

  <!-- Contenido Principal 404 -->
  <main class="flex-1 flex items-center justify-center px-4 py-16">
    <div class="max-w-xl mx-auto text-center">
      
      <!-- Ilustración Sacra de la Cruz y la Paloma de la Paz -->
      <div class="relative w-36 h-36 mx-auto mb-8 flex items-center justify-center">
        <div class="absolute inset-0 rounded-full bg-amber-100/70 border border-amber-300/60 animate-pulse"></div>
        
        <svg class="w-20 h-20 text-[#794625] relative z-10" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.5">
          <!-- Cruz Sacra -->
          <line x1="50" y1="12" x2="50" y2="88" stroke="#794625" stroke-width="5" stroke-linecap="round" />
          <line x1="24" y1="36" x2="76" y2="36" stroke="#794625" stroke-width="5" stroke-linecap="round" />
          <!-- Rayos de luz dorados -->
          <circle cx="50" cy="36" r="16" stroke="#D4AF37" stroke-width="1.5" stroke-dasharray="3 3" />
          <!-- Paloma sobrevolando -->
          <path d="M64 26 C66 22 72 20 75 22 C78 24 76 30 72 32 C68 34 65 31 64 26 Z" fill="#D4AF37" stroke="none" />
        </svg>
      </div>

      <!-- Código 404 con estilo litúrgico -->
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-widest uppercase bg-amber-100 text-[#794625] border border-amber-300/80 mb-4">
        Error 404 · Camino no encontrado
      </span>

      <!-- Mensaje Exacto Requerido por el Usuario -->
      <h1 class="font-cinzel text-3xl sm:text-4xl font-bold text-stone-900 mb-4 leading-tight">
        "Parece que nos hemos perdido en el camino."
      </h1>

      <p class="text-base sm:text-lg text-stone-600 mb-8 max-w-md mx-auto leading-relaxed">
        Esta página no se encuentra disponible o ha sido trasladada a una nueva sección de nuestra comunidad.
      </p>

      <!-- Cita inspiradora de San Francisco -->
      <div class="mb-10 p-4 rounded-xl bg-amber-50/70 border border-amber-200/70 max-w-md mx-auto text-sm text-stone-700 italic">
        "Señor, hazme un instrumento de tu paz. Donde haya duda, ponga yo fe; donde haya tinieblas, ponga yo luz."
      </div>

      <!-- Botón Requerido: "Volver al inicio" -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="index.html"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#794625] hover:bg-[#4A2814] text-white font-semibold text-sm tracking-wide shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center gap-2 group"
        >
          <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Volver al inicio</span>
        </a>

        <a
          href="index.html#servicios"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white hover:bg-stone-100 text-stone-800 border border-stone-300 font-semibold text-sm transition-all duration-200 text-center"
        >
          Horarios de Santa Misa
        </a>
      </div>

    </div>
  </main>

  <!-- Pie institucional -->
  <footer class="py-6 px-4 border-t border-stone-200/60 text-center text-xs text-stone-500 bg-white/50">
    <p>Capilla San Francisco de Asís · Parroquia La Santa Cruz · Diócesis de Chosica</p>
    <p class="mt-1 text-stone-400">Paz y Bien a todos los que nos visitan</p>
  </footer>

</body>
</html>
